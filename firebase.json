{
  "hosting": {
    "public": "out",
    "predeploy": ["npm --prefix \"$PROJECT_DIR\" run check:sitemap"],
    "cleanUrls": true,
    "trailingSlash": true,
    "404": "404.html",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/blog/artykul-1",
        "destination": "/blog/dlaczego-wybieram-podobnych-partnerow/",
        "type": 301
      },
      {
        "source": "/blog/artykul-1/",
        "destination": "/blog/dlaczego-wybieram-podobnych-partnerow/",
        "type": 301
      },
      {
        "source": "/blog/artykul-2",
        "destination": "/blog/dlaczego-sama-swiadomosc-nie-wystarcza/",
        "type": 301
      },
      {
        "source": "/blog/artykul-2/",
        "destination": "/blog/dlaczego-sama-swiadomosc-nie-wystarcza/",
        "type": 301
      },
      {
        "source": "/blog/artykul-3",
        "destination": "/blog/relacja-terapeutyczna-zrodlo-zmiany/",
        "type": 301
      },
      {
        "source": "/blog/artykul-3/",
        "destination": "/blog/relacja-terapeutyczna-zrodlo-zmiany/",
        "type": 301
      },
      {
        "source": "/blog/artykul-4",
        "destination": "/blog/czy-przeszlosc-ma-znaczenie/",
        "type": 301
      },
      {
        "source": "/blog/artykul-4/",
        "destination": "/blog/czy-przeszlosc-ma-znaczenie/",
        "type": 301
      },
      {
        "source": "/blog/jak-radzic-sobie-z-lekiem",
        "destination": "/kiedy-zglosic-sie-na-terapie/",
        "type": 301
      },
      {
        "source": "/blog/jak-radzic-sobie-z-lekiem/",
        "destination": "/kiedy-zglosic-sie-na-terapie/",
        "type": 301
      },
      {
        "source": "/blog/pierwsza-wizyta-u-psychologa",
        "destination": "/konsultacje-psychologiczne-wroclaw/",
        "type": 301
      },
      {
        "source": "/blog/pierwsza-wizyta-u-psychologa/",
        "destination": "/konsultacje-psychologiczne-wroclaw/",
        "type": 301
      },
      {
        "source": "/blog/psychoterapia-psychodynamiczna",
        "destination": "/psychoterapia-psychodynamiczna-wroclaw/",
        "type": 301
      },
      {
        "source": "/blog/psychoterapia-psychodynamiczna/",
        "destination": "/psychoterapia-psychodynamiczna-wroclaw/",
        "type": 301
      },
      {
        "source": "/blog/wypalenie-zawodowe",
        "destination": "/kiedy-zglosic-sie-na-terapie/",
        "type": 301
      },
      {
        "source": "/blog/wypalenie-zawodowe/",
        "destination": "/kiedy-zglosic-sie-na-terapie/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), interest-cohort=(), unload=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://firestore.googleapis.com wss://firestore.googleapis.com; frame-src https://www.google.com https://booksy.com https://*.booksy.com; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/fonts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=2592000"
          }
        ]
      },
      {
        "source": "/images/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=2592000"
          }
        ]
      },
      {
        "source": "**/*.@(webp|png|jpg|jpeg|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=2592000"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
