# dependencies
/node_modules
/functions/node_modules

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# oryginalne zdjęcia - wersje produkcyjne (WebP) są w public/images/
*.jpg
workspace-*.zip

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env
.env*.local

# typescript
*.tsbuildinfo

# firebase
.firebase/
*.log

# Firebase service-account private keys - never commit
**/service-account*.json
**/*firebase-adminsdk*.json

# Verification screenshots only; never served by static export.
!/docs/publikacja-slownika/zrzuty/*.jpg

# Local typography audit evidence (not exported by Next.js)
!/docs/typografia/zrzuty/**/*.jpg

# Optional contact Worker: local secrets and runtime state.
.dev.vars*
.wrangler/

# Hero and photograph audit screenshots (documentation, not site assets).
!/docs/fotografie/porownanie/*.jpg

# Homepage before/after screenshots and test evidence
!/docs/optymalizacja-gabinetu/*.jpg

!/docs/usuniecie-narzedzi/*.jpg
