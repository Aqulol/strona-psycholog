{
  "name": "gabinet-plebaniak",
  "version": "0.1.0",
  "private": true,
  "description": "Strona gabinetu psychologicznego Grzegorza Plebaniaka - Wrocław (Next.js 15, static export, Firebase Hosting)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "npx serve@latest out -l 3010",
    "check:export": "node scripts/check-export.mjs",
    "check:links": "node scripts/check-sitemap.mjs",
    "check:content": "node scripts/check-knowledge.mjs",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "lastmod:record": "node scripts/update-lastmod.mjs",
    "check:lastmod": "node scripts/check-lastmod.mjs",
    "postbuild": "node scripts/check-sitemap.mjs --write && node scripts/build-search.mjs && npm run check:sitemap",
    "check:sitemap:failures": "node scripts/check-sitemap-failures.mjs",
    "prebuild": "node scripts/glossary-registry.mjs --check",
    "predev": "node scripts/glossary-registry.mjs --check",
    "check:redirects": "node scripts/check-redirects.mjs",
    "check:indexability": "node scripts/check-indexability.mjs",
    "redirects:sync-html": "node scripts/sync-html-redirects.mjs"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "lucide-react": "^0.469.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "parse5": "^7.3.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  }
}
